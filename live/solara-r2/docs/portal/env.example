# Example server-side settings for a My Stay portal backend (Azure reference).
# These belong in your API's environment / Key Vault references — NEVER in assets/js or this repository.
# Values below are placeholders.

PORTAL_SITE_ORIGIN=https://www.your-villas.example
PORTAL_SESSION_MINUTES=120

# Identity (Microsoft Entra External ID via Static Web Apps custom auth)
ENTRA_EXTERNAL_TENANT_SUBDOMAIN=yourtenant
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET_SETTING=@Microsoft.KeyVault(SecretUri=https://your-vault.vault.azure.net/secrets/entra-client-secret/)

# Data
SQL_CONNECTION_SETTING=@Microsoft.KeyVault(SecretUri=https://your-vault.vault.azure.net/secrets/sql-connection/)
# or: COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/  (use managed identity, no key)

# Documents (private container; API issues short-lived read-only SAS per request)
BLOB_ACCOUNT_URL=https://yourstorage.blob.core.windows.net
BLOB_CONTAINER=guest-documents
DOCUMENT_LINK_MINUTES=5

# Email one-time codes / planner notifications
ACS_EMAIL_ENDPOINT=https://your-acs.communication.azure.com
ACS_EMAIL_SENDER=reservations@your-villas.example

# Abuse controls
SIGNIN_MAX_ATTEMPTS_PER_HOUR=10
